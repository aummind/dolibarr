[
    {
        "key": "ctrl+alt+k",
        "command": "workbench.action.terminal.new",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+alt+x",
        "command": "workbench.action.terminal.kill",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+alt+r",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "killhang b\r"
        },
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+alt+h",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "killhang a\r"
        },
        "when": "terminalFocus"
    }
]