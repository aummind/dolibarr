// Secret key for encryption (auto-generate if not set)
if (!isset($dolibarr_main_instance_unique_id) || empty($dolibarr_main_instance_unique_id)) {
    $dolibarr_main_instance_unique_id = 'dolibarr_' . md5(__DIR__ . microtime());
}

// Force HTTPS (set to 1 for production)
