    $dolibarr_main_cookie_cryptkey = 'codespace_' . $codespace_name;
} elseif ($is_docker) {
    $dolibarr_main_cookie_cryptkey = 'docker_' . gethostname();
} else {
    $dolibarr_main_cookie_cryptkey = 'local_' . md5(__DIR__);
}

