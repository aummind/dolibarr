<?php
// Dolibarr Smart Configuration Example
//
// This is an ENHANCED example configuration file that automatically detects
// common Docker environments and provides working defaults.
//
// To use this file:
// 1. Copy it to conf.php: cp conf.php.example conf.php
// 2. Edit the values if needed for your specific environment
// 3. Or let it auto-detect Docker environment settings
//
// Warning: Be sure not to add line feed or spaces after closing php tag!

// Auto-detection for Docker environment
$is_docker = file_exists('/.dockerenv') || getenv('DOCKER_CONTAINER') !== false;
$server_name = $_SERVER['SERVER_NAME'] ?? 'localhost';
$server_port = $_SERVER['SERVER_PORT'] ?? '80';

// Detect if we're in a GitHub Codespace
$is_codespace = !empty(getenv('CODESPACE_NAME'));
$codespace_name = getenv('CODESPACE_NAME');
$codespace_domain = getenv('GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN') ?: 'app.github.dev';


//###################
// Main parameters
//###################

// dolibarr_main_url_root
// ======================
// Auto-detect URL root based on environment
if ($is_codespace) {
    // GitHub Codespace environment
    $dolibarr_main_url_root = "https://{$codespace_name}-8080.{$codespace_domain}";
} elseif ($is_docker) {
    // Docker environment (development)
    $port_suffix = ($server_port != '80' && $server_port != '443') ? ":$server_port" : '';
    $dolibarr_main_url_root = "http://{$server_name}{$port_suffix}";
} else {
    // Manual configuration required
    // Examples:
    // $dolibarr_main_url_root = 'http://localhost';
    // $dolibarr_main_url_root = 'http://mydolibarrvirtualhost';
    // $dolibarr_main_url_root = 'http://myserver/dolibarr/htdocs';
    $dolibarr_main_url_root = 'http://localhost';
}

// dolibarr_main_document_root
// ===========================
// Auto-detect document root
if ($is_docker) {
    // Docker environment
    $dolibarr_main_document_root = '/var/www/html';
} else {
    // Auto-detect for other environments
    $dolibarr_main_document_root = realpath(__DIR__ . '/..');
}

// dolibarr_main_url_root_alt
// ==========================
// Alternative root directories for custom modules
// $dolibarr_main_url_root_alt = '/custom';

// dolibarr_main_document_root_alt
// ===============================
// Alternative document root for custom modules
if ($is_docker) {
    // $dolibarr_main_document_root_alt = '/var/www/html/custom';
} else {
    // $dolibarr_main_document_root_alt = realpath(__DIR__ . '/../custom');
}

// dolibarr_main_data_root
// =======================
// Data directory for documents and uploads
if ($is_docker) {
    // Docker environment - documents stored in mounted volume
    $dolibarr_main_data_root = '/var/www/html/documents';
} else {
    // Auto-detect for other environments
    $dolibarr_main_data_root = realpath(__DIR__ . '/../../documents');
}


//###################
// Database parameters
//###################

// Database configuration with Docker auto-detection
if ($is_docker) {
    // Docker environment: use compose service names and env when provided
    $dolibarr_main_db_host = getenv('DB_HOST') ?: 'db';
    $dolibarr_main_db_port = getenv('DB_PORT') ?: '3306';
    $dolibarr_main_db_name = getenv('DB_NAME') ?: 'dolibarr';
    $dolibarr_main_db_user = getenv('DB_USER') ?: 'dolibarr';
    $dolibarr_main_db_pass = getenv('DB_PASS') ?: 'dolibarrpass';
    $dolibarr_main_db_type = getenv('DB_TYPE') ?: 'mysqli';
} else {
    // Manual configuration required for non-Docker environments
    // Examples:
    // $dolibarr_main_db_host = 'localhost';
    // $dolibarr_main_db_host = '127.0.0.1';
    // $dolibarr_main_db_host = 'mysql.myserver.com';
    $dolibarr_main_db_host = 'localhost';
    
    // Database port
    // Examples:
    // $dolibarr_main_db_port = '3306';
    $dolibarr_main_db_port = '3306';
    
    // Database name
    // Examples:
    // $dolibarr_main_db_name = 'dolibarr';
    $dolibarr_main_db_name = 'dolibarr';
    
    // Database user
    // Examples:
    // $dolibarr_main_db_user = 'dolibarr';
    $dolibarr_main_db_user = 'dolibarr';
    
    // Database password
    // Examples:
    // $dolibarr_main_db_pass = 'yourpassword';
    $dolibarr_main_db_pass = '';
    
    // Database type
    // Examples:
    // $dolibarr_main_db_type = 'mysqli';
    // $dolibarr_main_db_type = 'pgsql';
    $dolibarr_main_db_type = 'mysqli';
}


