# Copy to .env and adjust values per environment

# App
APP_BASE_URL=https://example.local
TIMEZONE=Asia/Kolkata

# Database
DOLI_DB_HOST=db
DOLI_DB_PORT=3306
DOLI_DB_NAME=dolibarr
DOLI_DB_USER=dolibarr
DOLI_DB_PASS=change_me

# Admin bootstrap (used only on first install)
DOLI_ADMIN_USER=admin
DOLI_ADMIN_PASS=ChangeMeAdmin!

# Mail
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=username
SMTP_PASS=password
SMTP_FROM=noreply@example.com

# Localization / Compliance
COUNTRY=IN
STATE=KA
GST_ENABLED=1
# Enable if implementing e-invoicing integration
# GST_EINVOICE_ENABLED=1
# EINVOICE_PROVIDER="NIC|GSP"
# EINVOICE_API_BASE="https://<provider-endpoint>"
# EINVOICE_CLIENT_ID=
# EINVOICE_CLIENT_SECRET=
# EINVOICE_GSP_GSTIN=
KARNATAKA_RULES=1

# Optional services
REDIS_HOST=redis
REDIS_PORT=6379
# Toggle via scripts/project/redis_toggle.sh for sessions; these variables are available to the app if needed
# REDIS_ENABLED=0
